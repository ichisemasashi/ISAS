{
  "name": "@isas/bff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node bin/server.mjs start",
    "check:config": "node bin/server.mjs check-config",
    "service:start": "sh bin/runtime-control.sh start",
    "service:stop": "sh bin/runtime-control.sh stop",
    "service:restart": "sh bin/runtime-control.sh restart",
    "service:status": "sh bin/runtime-control.sh status",
    "test": "node --test",
    "check": "node --check bin/server.mjs && node --check runtime-adapters/*.mjs && node --check src/*.mjs && node --check test/*.test.mjs && sh -n bin/runtime-control.sh"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1100.0",
    "@aws-sdk/client-dynamodb": "3.1100.0",
    "@aws-sdk/client-kms": "3.1100.0",
    "@aws-sdk/client-s3": "^3.1100.0",
    "@aws-sdk/client-sqs": "3.1109.0",
    "@aws-sdk/s3-request-presigner": "^3.1100.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.79.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.221.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "jose": "6.2.3",
    "pg": "8.22.0"
  }
}
