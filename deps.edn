{:paths ["src/clj" "src/cljc" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/data.json {:mvn/version "2.5.1"}
        org.clojure/tools.logging {:mvn/version "1.3.0"}
        ch.qos.logback/logback-classic {:mvn/version "1.5.16"}
        ring/ring-core {:mvn/version "1.13.0"}
        ring/ring-jetty-adapter {:mvn/version "1.13.0"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.1002"}
        org.xerial/sqlite-jdbc {:mvn/version "3.47.1.0"}
        buddy/buddy-hashers {:mvn/version "2.0.167"}
        com.draines/postal {:mvn/version "2.0.5"}}
 :aliases
 {:run {:main-opts ["-m" "isas.core"]}
  :cljs {:extra-deps {thheller/shadow-cljs {:mvn/version "2.28.23"}
                     org.clojure/clojurescript {:mvn/version "1.11.132"}}
         :extra-paths ["src/cljs" "test/cljs"]}
  :test {:extra-paths ["test/clj" "test/resources"]
         :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      ring/ring-mock {:mvn/version "0.4.0"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :coverage {:extra-paths ["test/clj" "test/resources"]
             :extra-deps {cloverage/cloverage {:mvn/version "1.2.4"}
                          ring/ring-mock {:mvn/version "0.4.0"}}
             :main-opts ["-m" "cloverage.coverage"
                         "--src-ns-path" "src/clj"
                         "--src-ns-path" "src/cljc"
                         "--test-ns-path" "test/clj"
                         "--fail-threshold" "100"
                         "--codecov"
                         "--html"]}}}
