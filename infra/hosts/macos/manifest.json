{
  "schema_version": 1,
  "profile_id": "macos-production",
  "host_os": "macos",
  "root": "/Library/Application Support/ISAS/Production",
  "log_root": "/Library/Logs/ISAS/Production",
  "secret_adapter": "system-keychain-or-approved-external-adapter",
  "external_monitor_required": true,
  "slo": { "p0_availability": 0.999, "p0_latency_ms": 500 },
  "services": [
    { "name": "database", "label": "com.isas.database", "user": "_isas_db", "listen": "127.0.0.1:6432", "artifact": "database.pkg" },
    { "name": "identity", "label": "com.isas.identity", "user": "_isas_idp", "listen": "127.0.0.1:8443", "artifact": "identity.pkg" },
    { "name": "object-queue", "label": "com.isas.object-queue", "user": "_isas_objq", "listen": "127.0.0.1:9000,127.0.0.1:4222", "artifact": "object-queue.pkg" },
    { "name": "app", "label": "com.isas.app", "user": "_isas_app", "listen": "127.0.0.1:3000", "artifact": "app.pkg" },
    { "name": "edge", "label": "com.isas.edge", "user": "_isas_edge", "listen": "0.0.0.0:8444", "external": "443/tcp-via-pf", "artifact": "edge.pkg" },
    { "name": "telemetry", "label": "com.isas.telemetry", "user": "_isas_otel", "listen": "127.0.0.1:4317,127.0.0.1:4318", "artifact": "telemetry.pkg" }
  ],
  "start_order": ["database", "identity", "object-queue", "app", "edge", "telemetry"],
  "stop_order": ["edge", "app", "telemetry", "object-queue", "identity", "database"]
}
