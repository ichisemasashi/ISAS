<key>Label</key><string>com.isas.identity</string><key>UserName</key><string>_isas_idp</string>
<key>ProgramArguments</key><array><string>/Library/Application Support/ISAS/Production/current/identity/bin/start</string><string>--config</string><string>/Library/Application Support/ISAS/Production/config/identity.conf</string></array>
