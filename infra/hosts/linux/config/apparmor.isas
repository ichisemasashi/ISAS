#include <tunables/global>

/opt/isas/releases/*/database/bin/start flags=(attach_disconnected) {
  #include <abstractions/base>
  network inet stream,
  network inet6 stream,
  /opt/isas/releases/*/database/** rix,
  /var/lib/isas/database/** rwk,
  /run/isas/database/** rwk,
  /run/credentials/isas-database.service/config r,
  #include if exists <local/isas-database>
}

