[Unit]
Description=ISAS application boundary
PartOf=isas.target
Requires=isas-database.service isas-identity.service isas-object-queue.service
After=isas-database.service isas-identity.service isas-object-queue.service
RequiresMountsFor=/var/lib/isas
ConditionPathIsMountPoint=/var/lib/isas
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=isas-app
Group=isas-app
WorkingDirectory=/var/lib/isas/app
LoadCredentialEncrypted=config:/etc/isas/credentials/app.cred
ExecStart=/opt/isas/current/app/bin/start --config %d/config
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/isas/app /run/isas/app
LimitNOFILE=65536
LogNamespace=isas
