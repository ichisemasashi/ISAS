{
  "schemaVersion": 1,
  "profileId": "jp-prod-aws-tokyo-v1",
  "deploymentId": "isas-jp-prod-01",
  "jurisdiction": "JP",
  "cloud": "aws",
  "accountAlias": "isas-jp-prod",
  "region": "ap-northeast-1",
  "availabilityZoneCount": 3,
  "crossRegionReplication": false,
  "compute": { "service": "ecs-fargate", "minimumBffTasks": 3 },
  "database": {
    "service": "rds-postgresql-multi-az-db-cluster",
    "postgresVersion": "16.14R2",
    "postgisVersion": "3.4.6",
    "pooler": "pgbouncer-1.24.x"
  },
  "identity": { "service": "cognito-user-pools", "tier": "plus", "primaryFactor": "webauthn-passkey", "webauthnFactorConfiguration": "MULTI_FACTOR_WITH_USER_VERIFICATION", "fallbackMfa": "totp" },
  "sessionStore": { "service": "dynamodb-standard", "globalTable": false, "table": "isas-jp-prod-session-context" },
  "objectStore": { "service": "s3-standard", "public": false, "versioning": true, "crossRegionReplication": false },
  "queue": { "service": "sqs-standard", "deadLetterQueues": true },
  "keys": { "service": "kms", "regionality": "single-region", "customerManaged": true },
  "cicd": { "service": "github-actions", "awsAuthentication": "iam-oidc", "longLivedKeys": false },
  "artifactRegistry": { "service": "ecr-private", "immutableTags": true, "enhancedScanning": true },
  "telemetry": { "collector": "adot", "store": ["cloudwatch", "xray"], "region": "ap-northeast-1" },
  "backup": { "dailyRestorePoints": 30, "weeklyRestorePoints": 12, "region": "ap-northeast-1" },
  "infrastructureAsCode": { "tool": "opentofu", "version": "1.12.5", "implementation": "infra/opentofu" },
  "stagingAcceptance": { "requiredChecks": 18, "status": "BLOCKED_PENDING_AWS_APPLY" },
  "productionReleaseStatus": "BLOCKED_PENDING_STAGING_ACCEPTANCE"
}
